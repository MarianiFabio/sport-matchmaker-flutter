@startuml
skinparam roundcorner 8
skinparam defaultFontSize 12
skinparam BoxPadding 10
skinparam responseMessageBelowArrow false

skinparam sequence {
    ParticipantBackgroundColor White
    ParticipantBorderColor DarkSlateGray
    LifeLineBorderColor DarkSlateGray
    ArrowColor #2C3E50
}
autonumber

actor "Player" as P
participant "Client (App)" as C
participant "Backend API" as S
database "Database" as DB
actor "Organizer" as O

P -> C : Join Match
activate C

C -> S : POST /api/bookings {matchId}
activate S

S -> DB : SELECT remaining_slots
activate DB
DB --> S : available_slots
deactivate DB

alt Slots available (> 0)
    S -> DB : INSERT INTO Booking (PENDING)
    activate DB
    DB --> S : OK
    deactivate DB

    S --> C : 201 Created (Pending)
    C --> P : UI: "Pending approval"
    S -> O : Push: "New booking request"

else Match full (== 0)
    S --> C : 409 Conflict
    C --> P : Alert: "Match is full"
end

deactivate S
deactivate C
@enduml