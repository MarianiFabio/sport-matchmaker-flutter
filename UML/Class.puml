@startuml
skinparam classAttributeIconSize 0
skinparam roundcorner 10

' --- ENUMS ---
enum MatchStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

' --- MAIN CLASSES (WITH INHERITANCE) ---
abstract class User {
  - idUser: Integer
  - firstName: String
  - lastName: String
  - email: String
  - passwordHash: String
  - username: String
  - karmaScore: Integer
  - skillLevel: String
  + authenticate(): Boolean
  + updateProfile(): void
}

class Player {
  + searchMatches(filters: Object): List<Match>
  + joinMatch(m: Match): JoinRequest
  + leaveMatch(m: Match): void
}

class Organizer {
  + createMatch(): Match
  + editMatch(m: Match): void
  + cancelMatch(m: Match): void
  + reviewRequest(req: JoinRequest, isAccepted: Boolean): void
}

' Inheritance
User <|-- Player
User <|-- Organizer

' --- DOMAIN CLASSES ---
class Match {
  - idMatch: Integer
  - date: Date
  - startTime: Time
  - endTime: Time
  - totalSpots: Integer
  - availableSpots: Integer
  - pricePerPerson: Float
  - matchStatus: MatchStatus
  + updateSpots(): void
  + getDetails(): String
}

class Sport {
  - idSport: Integer
  - sportName: String
  - defaultPlayers: Integer
}

class Venue {
  - idVenue: Integer
  - facilityName: String
  - address: String
  - latitude: Double
  - longitude: Double
  + getLocation(): String
}

' --- INTERMEDIATE CLASS (N:M Resolution) ---
class JoinRequest {
  - idRequest: Integer
  - requestDate: DateTime
  - requestStatus: RequestStatus
  + updateStatus(newStatus: RequestStatus): void
}

' --- RELATIONSHIPS AND CARDINALITY ---
Organizer "1" --> "*" Match : creates >
Match "*" -right-> "1" Sport : belongs to >
Match "*" -right-> "1" Venue : takes place at >

Player "1" --> "*" JoinRequest : makes >
Match "1" -left-> "*" JoinRequest : receives >

@enduml