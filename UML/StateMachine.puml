@startuml
skinparam roundcorner 10
skinparam state {
  BackgroundColor LightBlue
  BorderColor DarkSlateGray
  ArrowColor #2C3E50
}

title State Machine Diagram: Lifecycle of a Match

[*] --> OPEN : Organizer creates match

state OPEN {
  [*] --> Accepting_Requests
  Accepting_Requests : SOS Push Notifications = ACTIVE
}

state FULL {
  [*] --> Roster_Complete
  Roster_Complete : SOS Push Notifications = INACTIVE
  Roster_Complete : Event Chat = ACTIVE
}

state CANCELLED {
  [*] --> Notifying_Players
  Notifying_Players : Alerts sent to joined players
}

OPEN --> FULL : Player joins\n[available_places == 0]
FULL --> OPEN : Player leaves (Leave Match)\n[available_places > 0]

OPEN -left-> CANCELLED : Organizer cancels match
FULL -left-> CANCELLED : Organizer cancels match

OPEN -right-> COMPLETED : Match date & time passed
FULL -right-> COMPLETED : Match date & time passed

CANCELLED --> [*]
COMPLETED --> [*]
@enduml