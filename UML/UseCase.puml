@startuml
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 10

actor "User" as U
actor "Organizer" as O

' Specializzazione: Organizer eredita tutte le azioni dello User
O -up-|> U

rectangle "Amateur Sports Platform" {

    ' Accesso e Profilo
    usecase "Authenticate (Login / Register)" as UC_Auth
    usecase "Manage Profile & Reliability" as UC_Profile
    usecase "Receive Notifications" as UC_Notif

    ' Ricerca Partite Pubbliche
    usecase "Search Public Matches" as UC_Search
    usecase "Filter by Sport & Date" as UC_Filter
    usecase "Search Nearby Matches (GPS)" as UC_SearchNear
    usecase "View Match Details" as UC_Details
    usecase "Request to Join Match" as UC_Join

    ' Le Mie Partite (Iscrizioni e Storico)
    usecase "View My Matches" as UC_MyMatches
    usecase "View Upcoming Matches" as UC_Upcoming
    usecase "View Past Matches" as UC_Past
    usecase "Leave Match" as UC_Leave

    ' Azioni specifiche dell'Organizzatore
    usecase "Create Match" as UC_Create
    usecase "Manage Created Matches" as UC_Manage
    usecase "Review Join Requests" as UC_Requests
}

' Collegamenti Utente (Base)
U --> UC_Auth
U --> UC_Profile
U --> UC_Notif
U --> UC_Search
U --> UC_MyMatches

' Specializzazioni della ricerca pubblica
UC_Filter -up-|> UC_Search
UC_SearchNear -up-|> UC_Search

' Flusso Dettaglio e Partecipazione
UC_Details .left.> UC_Search : <<extend>>
UC_Join .up.> UC_Details : <<extend>>

' Specializzazioni "Le Mie Partite"
UC_Upcoming -up-|> UC_MyMatches
UC_Past -up-|> UC_MyMatches
UC_Leave .up.> UC_Upcoming : <<extend>>

' Collegamenti Organizzatore
O --> UC_Create
O --> UC_Manage
UC_Requests .up.> UC_Manage : <<extend>>

@enduml